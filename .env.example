# RouterAI: ключ хранится только на сервере
ROUTERAI_API_KEY=replace-with-routerai-key
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=deepseek/deepseek-v4-pro
ROUTERAI_MAX_TOKENS=4000
ROUTERAI_TEMPERATURE=0.25
ROUTERAI_TIMEOUT_MS=60000

# Администратор
ADMIN_EMAIL=dimamarareskul@gmail.com
# Получить: npm run hash-password -- "сложный пароль длиной не менее 12 символов"
ADMIN_PASSWORD_HASH=scrypt$replace-salt$replace-hash
# Случайная строка длиной не менее 32 символов
SESSION_SECRET=replace-with-long-random-secret
ADMIN_SESSION_TTL_MINUTES=480

# Публичная демонстрация: PUBLIC | INVITE_ONLY | DISABLED
PUBLIC_MODE=PUBLIC
# Требуется только для INVITE_ONLY. Ссылка может иметь вид /?code=...
DEMO_INVITE_CODE=replace-with-invite-code
PUBLIC_SESSION_MESSAGE_LIMIT=20
PUBLIC_IP_DAILY_LIMIT=40
PUBLIC_GLOBAL_DAILY_LIMIT=500
PUBLIC_MAX_INPUT_CHARS=4000

# Ежедневная проверка и осторожное обновление ссылок DNS
DNS_LINK_AUTO_UPDATE=true
# Час запуска по UTC, 0-23. 03:00 UTC = 05:00 летом в Амстердаме
DNS_LINK_UPDATE_HOUR_UTC=3
DNS_LINK_TIMEOUT_MS=20000
# Пауза между обращениями к DNS, чтобы не создавать нагрузку
DNS_LINK_DELAY_MS=1500
