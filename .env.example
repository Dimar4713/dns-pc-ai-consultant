# =============================================================
# DNS PC AI Consultant — шаблон переменных окружения
# Скопируйте файл в .env и заполните нужные значения
# =============================================================


# -------------------------------------------------------------
# ROUTERAI — подключение к AI-модели
# -------------------------------------------------------------

ROUTERAI_API_KEY=                          # обязательно: ключ API RouterAI.ru
ROUTERAI_BASE_URL=https://routerai.ru/api/v1  # базовый URL API (менять не нужно)
ROUTERAI_MODEL=deepseek/deepseek-v4-pro    # модель (можно сменить из админки)
ROUTERAI_TEMPERATURE=0.1                   # 0 = точнее, 1 = креативнее
ROUTERAI_MAX_TOKENS=8000                   # макс. длина ответа (500–8000)
ROUTERAI_TIMEOUT_MS=180000                 # таймаут запроса в мс (до 180000)


# -------------------------------------------------------------
# ПУБЛИЧНАЯ ЧАСТЬ — лимиты доступа
# -------------------------------------------------------------

# Режим работы публичного чата:
#   PUBLIC       — открыт для всех
#   INVITE_ONLY  — только по коду (DEMO_INVITE_CODE)
#   DISABLED     — закрыт
PUBLIC_MODE=PUBLIC

DEMO_INVITE_CODE=                          # код доступа при INVITE_ONLY

PUBLIC_SESSION_MESSAGE_LIMIT=20            # сообщений на одну сессию
PUBLIC_IP_DAILY_LIMIT=40                   # запросов с одного IP в сутки
PUBLIC_GLOBAL_DAILY_LIMIT=500             # всего запросов в сутки глобально
PUBLIC_MAX_INPUT_CHARS=4000               # макс. длина сообщения пользователя

# Приветственное сообщение (необязательно — есть дефолт в коде)
# PUBLIC_WELCOME=Здравствуйте! Я помогу подобрать сборку...


# -------------------------------------------------------------
# АДМИН-ПАНЕЛЬ
# -------------------------------------------------------------

ADMIN_EMAIL=dimamarareskul@gmail.com       # логин администратора
ADMIN_PASSWORD_HASH=                       # scrypt-хеш пароля (генерируется утилитой)
# ADMIN_PASSWORD=                          # пароль открытым текстом (только для dev!)

ADMIN_SESSION_TTL_MINUTES=480              # время жизни сессии админа в минутах (15–1440)


# -------------------------------------------------------------
# БЕЗОПАСНОСТЬ
# -------------------------------------------------------------

SESSION_SECRET=                            # обязательно: случайная строка 32+ символа


# -------------------------------------------------------------
# DNS-ССЫЛКИ — автопроверка (отключена по умолчанию)
# -------------------------------------------------------------

DNS_LINK_AUTO_UPDATE=false                 # включить фоновую проверку ссылок
DNS_LINK_UPDATE_HOUR_UTC=3                 # час запуска по UTC (0–23)
DNS_LINK_TIMEOUT_MS=20000                  # таймаут одного запроса к DNS
DNS_LINK_DELAY_MS=1500                     # задержка между запросами в мс
